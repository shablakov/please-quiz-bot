Код бота (bot.py):
Python
import asyncio
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes

# Токен от @BotFather
TOKEN = "ВАШ_ТОКЕН_ОТ_BOTFATHER"

# База вопросов (потом вынесем в json)
QUESTIONS = [
    {
        "q": "❓ **Вопрос 1 (Логика):** В XIX веке на афишах лондонского театра писали: «Дамам в пышных шляпах скидка 50%, но с условием...». Какое условие ставили?",
        "a": "💡 **Ответ:** Скидка предоставляется только ПОЖИЛЫМ дамам. (После этого все женщины снимали шляпы сами).",
        "time": 60
    },
    {
        "q": "❓ **Вопрос 2 (Кино):** Какая практическая причина заставила Кристофера Ллойда (Дока) сутулиться в фильме «Назад в будущее»?",
        "a": "💡 **Ответ:** Большая разница в росте с Майклом Дж. Фоксом (чтобы они влезали в один кадр).",
        "time": 45
    }
]

current_q = 0

async def start_quiz(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Старт тренировки в чате"""
    global current_q
    current_q = 0
    await update.message.reply_text("🚀 **Тренировка Please Quiz началась!**\nКоманда `/q` — выдать следующий вопрос.")

async def next_question(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Выдать вопрос и запустить таймер"""
    global current_q
    chat_id = update.effective_chat.id

    if current_q < len(QUESTIONS):
        item = QUESTIONS[current_q]
        await context.bot.send_message(chat_id=chat_id, text=item["q"], parse_mode="Markdown")
        
        # Сообщение о запуске таймера
        timer_msg = await context.bot.send_message(
            chat_id=chat_id, 
            text=f"⏱ Время на обсуждение: **{item['time']} секунд**!", 
            parse_mode="Markdown"
        )
        
        # Ждём время на обсуждение
        await asyncio.sleep(item["time"])
        
        # Выдаём ответ по истечении времени
        await context.bot.send_message(chat_id=chat_id, text=item["a"], parse_mode="Markdown")
        current_q += 1
    else:
        await context.bot.send_message(chat_id=chat_id, text="🏁 **Пакет вопросов окончен!** Отличная работа.")

if __name__ == '__main__':
    app = ApplicationBuilder().token(TOKEN).build()
    
    app.add_handler(CommandHandler("quiz", start_quiz))
    app.add_handler(CommandHandler("q", next_question))
    
    print("Бот запущен и готов к работе...")
    app.run_polling()
Как происходит тренировка в группе:
Вы пишете в групповой чат команду /quiz (бот приветствует команду).

Пишете /q — бот отправляет текст вопроса и включает отсчёт (например, 60 секунд).

В течение 60 секунд вся команда пишет варианты, гипотезы и накручивает логику прямо в чате.

По истечении 60 секунд бот автоматически присылает правильный ответ и пояснение.

Пишете /q — переходите к следующему вопросу.

